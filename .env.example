# Copy to .env and fill in. Never commit .env.

# Anthropic API key (only POST /api/plan uses it)
ANTHROPIC_API_KEY=

# Access codes for screen 0
OWNER_CODE=
EVALUATOR_CODE=

# Long random string used to sign the session cookie (32+ chars)
SESSION_SECRET=

# Max AI plans the evaluator role can generate (default 5)
EVALUATOR_PLAN_LIMIT=

# Max AI plans across all roles per UTC day (default 50)
DAILY_PLAN_LIMIT=

# Optional: folder for persisted counters and cache (e.g. a Railway volume at /data)
DATA_DIR=
